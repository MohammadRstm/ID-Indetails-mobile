# The API the app talks to: its origin, without /api.
# Android emulator → the laptop: http://10.0.2.2:5164
# A phone on the same Wi-Fi: http://<the PC's LAN IP>:5164
# Preview and production builds need https:// (set as EAS environment variables, not here).
EXPO_PUBLIC_API_URL=http://10.0.2.2:5164
